# ─────────────────────────────────────────
# Twilio
# ─────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+61xxxxxxxxx

# ─────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/voice_booking

# ─────────────────────────────────────────
# Google Calendar / OAuth
# ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
GOOGLE_CALENDAR_ID=primary

# ─────────────────────────────────────────
# n8n
# ─────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=https://your-n8n-domain.com
N8N_API_KEY=your_n8n_api_key

# ─────────────────────────────────────────
# Email (SMTP / SendGrid / etc.)
# ─────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=noreply@yourbusiness.com

# ─────────────────────────────────────────
# Ollama (local AI via ngrok tunnel — optional)
# Replace with your ngrok HTTPS URL each session,
# or set a static domain if on ngrok paid plan.
# Local fallback: http://localhost:11434
# ─────────────────────────────────────────
OLLAMA_BASE_URL=https://your-ngrok-id.ngrok-free.app
OLLAMA_MODEL=llama3.2

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
TIMEZONE=Australia/Melbourne

# ─────────────────────────────────────────
# Webhook security
# ─────────────────────────────────────────
WEBHOOK_SECRET=your_webhook_secret
TWILIO_WEBHOOK_VALIDATION=true
