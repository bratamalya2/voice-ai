# ─────────────────────────────────────────
# Next.js App
# ─────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# ─────────────────────────────────────────
# Backend API
# ─────────────────────────────────────────
# Used server-side only (no NEXT_PUBLIC_ prefix)
BACKEND_API_URL=http://localhost:3001
BACKEND_API_SECRET=your_internal_api_secret

# ─────────────────────────────────────────
# Database (server-side only, for direct reads if needed)
# ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5432/voice_booking

# ─────────────────────────────────────────
# Authentication (dashboard login)
# ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_32_chars_min

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NODE_ENV=development
TIMEZONE=Australia/Melbourne
